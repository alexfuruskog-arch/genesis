FRONTEND_ORIGIN=http://127.0.0.1:43123

# Supabase (optional locally — the API falls back to an in-memory store)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM (optional — mock quiz questions if no key is set)
LLM_PROVIDER=auto
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Shopify (optional — mock catalog/checkout if Admin token is missing)
SHOPIFY_STORE_URL=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_OAUTH_SCOPES=read_customers,write_customers,read_products,write_draft_orders
SHOPIFY_OAUTH_REDIRECT_URI=http://127.0.0.1:43123/shopify/callback
