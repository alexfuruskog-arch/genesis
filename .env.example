# Copy into backend/.env and frontend/.env.local as needed.
# Local run works with empty secrets (in-memory store + mock LLM + mock Shopify).

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:48721
API_PROXY_TARGET=http://127.0.0.1:48721
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Custom domain; fallback: sexb4g-xw.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=arzive.org
NEXT_PUBLIC_SHOPIFY_CORNELL_HANDLE=arzive-cornell-notebook
NEXT_PUBLIC_SHOPIFY_MATH_HANDLE=arzive-math-notebook
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_KEY=

# Backend
FRONTEND_ORIGIN=http://127.0.0.1:43123
SUPABASE_URL=
