{%- comment -%}
  Homepage product panel: ONE full-bleed cover + copy. No diptych / pasted gallery.
{%- endcomment -%}
{%- liquid
  assign title = fallback_title
  assign text = fallback_text
  assign url = routes.all_products_collection_url
  assign price = ''

  if product != blank
    assign title = product.title
    if product.description != blank
      assign text = product.description | strip_html | truncate: 220
    endif
    assign url = product.url
    assign price = product.price | money
  elsif fallback_handle != blank
    assign url = '/products/' | append: fallback_handle
  endif

  if cover_asset == blank
    assign cover_asset = 'notebook-cream.jpg'
  endif
-%}

<article class="arzive-showcase">
  <figure class="arzive-showcase__figure">
    <img
      class="arzive-showcase__img"
      src="{{ cover_asset | asset_url }}"
      alt="{{ title | escape }}"
      width="1400"
      height="1750"
      loading="lazy"
    >
  </figure>

  <div class="arzive-showcase__copy">
    <p class="arzive-showcase__color">{{ color_name }}</p>
    <h2 class="arzive-showcase__title">{{ title }}</h2>
    <p class="arzive-showcase__text">{{ text }}</p>
    {% if price != blank %}
      <p class="arzive-showcase__price">{{ price }}</p>
    {% endif %}
    <a class="arzive-btn arzive-btn--solid" href="{{ url }}">Go to shop</a>
  </div>
</article>
