{%- liquid
  assign p = product
  if p == blank and handle != blank
    assign p = all_products[handle]
  endif
  assign title = title_fallback
  assign text = description_fallback
  assign url = routes.root_url
  assign price = ''
  assign is_math = false
  if p != blank
    assign title = p.title
    if p.description != blank
      assign text = p.description | strip_html | truncate: 200
    endif
    assign url = p.url
    assign price = p.price | money
    assign handle_check = p.handle
  elsif handle != blank
    assign url = '/products/' | append: handle
    assign handle_check = handle
  else
    assign handle_check = ''
  endif
  if handle_check contains 'math'
    assign is_math = true
  endif
  if cover_asset == blank
    if is_math
      assign cover_asset = 'notebook-green.jpg'
    else
      assign cover_asset = 'notebook-cream.jpg'
    endif
  endif
  if color_name == blank
    if is_math
      assign color_name = 'Forest green'
    else
      assign color_name = 'Cream'
    endif
  endif
  if color_hex == blank
    if is_math
      assign color_hex = '#0B2421'
    else
      assign color_hex = '#F5F5F0'
    endif
  endif
-%}

<article class="arzive-card">
  <a class="arzive-card__media" href="{{ url }}">
    <img src="{{ cover_asset | asset_url }}" alt="{{ title | escape }}" width="1200" height="1500" loading="lazy">
  </a>
  <div class="arzive-card__body">
    <div class="arzive-card__meta">
      <span class="arzive-swatch" style="background:{{ color_hex }}"></span>
      <span>{{ color_name }}</span>
    </div>
    <h2 class="arzive-card__title"><a href="{{ url }}">{{ title }}</a></h2>
    {% if text != blank %}<p class="arzive-card__text">{{ text }}</p>{% endif %}
    {% if price != blank %}<p class="arzive-card__price">{{ price }}</p>{% endif %}
    <a class="arzive-btn arzive-btn--forest" href="{{ url }}">Go to shop</a>
  </div>
</article>
