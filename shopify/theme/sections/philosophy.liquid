<section class="arzive-philosophy{% if section.settings.forest %} arzive-philosophy--forest{% endif %}">
  <div class="{% if section.settings.framed %}arzive-philosophy__frame{% else %}arzive-shell{% endif %}">
    <p class="arzive-philosophy__label">{{ section.settings.label | default: "Arzive's philosophy" }}</p>
    <h2 class="arzive-philosophy__title">
      {{ section.settings.title | default: 'We believe every student deserves the tools to succeed.' }}
    </h2>
    {% if section.settings.body != blank %}
      <p class="arzive-philosophy__text" style="margin:1.25rem auto 0;max-width:36rem;font-weight:300;line-height:1.7;opacity:0.8;">
        {{ section.settings.body }}
      </p>
    {% endif %}
    <p class="arzive-philosophy__tag">
      {{ section.settings.tagline | default: 'The only notebook that teaches you how to study.' }}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Philosophy",
  "tag": "section",
  "class": "section-philosophy",
  "settings": [
    { "type": "checkbox", "id": "forest", "label": "Forest background", "default": false },
    { "type": "checkbox", "id": "framed", "label": "Dashed frame", "default": false },
    { "type": "text", "id": "label", "label": "Label", "default": "Arzive's philosophy" },
    { "type": "textarea", "id": "title", "label": "Title", "default": "We believe every student deserves the tools to succeed." },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "The only notebook that teaches you how to study." }
  ],
  "presets": [{ "name": "ARZIVE philosophy" }]
}
{% endschema %}
