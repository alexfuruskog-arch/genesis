<section class="arzive-choose">
  <div class="arzive-shell arzive-choose__grid">
    <div class="arzive-choose__photos">
      <img
        src="{{ 'hero-lifestyle-cream.jpg' | asset_url }}"
        alt="Student with Cream Cornell Notebook"
        width="1000"
        height="750"
        loading="lazy"
      >
      <img
        src="{{ 'bundle-cornell-math.jpg' | asset_url }}"
        alt="Cream Cornell and Green Math study system pair"
        width="1000"
        height="750"
        loading="lazy"
      >
    </div>
    <div>
      <h2 class="arzive-choose__title">{{ section.settings.heading | default: 'Choose Arzive' }}</h2>
      <div class="arzive-choose__block">
        <h3>{{ section.settings.block_1_label | default: 'Research-driven, user-approved' }}</h3>
        <p>{{ section.settings.block_1 | default: "We've helped 100,000+ students transform the way they learn with systems built for real classrooms — Cream Cornell and Green Math." }}</p>
      </div>
      <div class="arzive-choose__block">
        <h3>{{ section.settings.block_2_label | default: 'Positive transfer, risk-free' }}</h3>
        <p>{{ section.settings.block_2 | default: "Try ARZIVE risk-free with our 6-month money-back guarantee. If it doesn't change how you study, send it back." }}</p>
      </div>
      <div class="arzive-choose__block">
        <h3>{{ section.settings.block_3_label | default: 'Personal growth with the world in mind' }}</h3>
        <p>{{ section.settings.block_3 | default: '5% of profits support education charities. Premium paper shouldn’t cost the planet — or your focus.' }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Choose Arzive",
  "tag": "section",
  "class": "section-choose",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose Arzive" },
    { "type": "text", "id": "block_1_label", "label": "Block 1 label", "default": "Research-driven, user-approved" },
    { "type": "textarea", "id": "block_1", "label": "Block 1" },
    { "type": "text", "id": "block_2_label", "label": "Block 2 label", "default": "Positive transfer, risk-free" },
    { "type": "textarea", "id": "block_2", "label": "Block 2" },
    { "type": "text", "id": "block_3_label", "label": "Block 3 label", "default": "Personal growth with the world in mind" },
    { "type": "textarea", "id": "block_3", "label": "Block 3" }
  ],
  "presets": [{ "name": "ARZIVE choose" }]
}
{% endschema %}
