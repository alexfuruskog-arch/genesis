<section class="arzive-sustain{% if section.settings.compact %} arzive-sustain--compact{% endif %}">
  <div class="arzive-shell">
    <h2 class="arzive-sustain__title">
      {{ section.settings.heading | default: "Premium doesn't mean wasteful. We use natural, recycled, and compostable materials to protect our shared home." }}
    </h2>
    <div class="arzive-sustain__grid">
      <div class="arzive-sustain__item">
        <div class="arzive-sustain__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M8 4h5l3 6v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.2"/>
            <path d="M5 5l14 14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
        </div>
        <strong>100% plastic-free</strong>
        {% unless section.settings.compact %}
          <p>No plastic wraps. Packaging that breaks down cleanly.</p>
        {% endunless %}
      </div>
      <div class="arzive-sustain__item">
        <div class="arzive-sustain__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M7 8.5 12 4l5 4.5M17 15.5 12 20l-5-4.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M8.5 10.5h7v3h-7v-3Z" stroke="currentColor" stroke-width="1.2"/>
          </svg>
        </div>
        <strong>100% recycled FSC™ paper</strong>
        {% unless section.settings.compact %}
          <p>Shipments packed with recycled materials end to end.</p>
        {% endunless %}
      </div>
      <div class="arzive-sustain__item">
        <div class="arzive-sustain__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M12 20c-3-2.5-6-5.2-6-9a6 6 0 1 1 12 0c0 3.8-3 6.5-6 9Z" stroke="currentColor" stroke-width="1.2"/>
            <path d="M12 11.5v3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
        </div>
        <strong>100% natural materials</strong>
        {% unless section.settings.compact %}
          <p>Paper and covers chosen for feel, durability, and footprint.</p>
        {% endunless %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sustainability",
  "tag": "section",
  "class": "section-sustain",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Premium doesn't mean wasteful. We use natural, recycled, and compostable materials to protect our shared home."
    },
    {
      "type": "checkbox",
      "id": "compact",
      "label": "Icons + labels only",
      "default": false
    }
  ],
  "presets": [{ "name": "ARZIVE sustainability" }]
}
{% endschema %}
