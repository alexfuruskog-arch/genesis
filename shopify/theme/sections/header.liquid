{%- liquid
  assign study_url = settings.study_app_url | default: 'https://study.arzive.com/study'
  assign account_url = settings.account_app_url | default: study_url | replace: '/study', '/account'
  assign story_url = pages['our-story'].url | default: '/pages/our-story'
-%}

<div class="arzive-announce">
  <a href="{{ routes.all_products_collection_url }}">
    {{ section.settings.text | default: 'Free shipping over $75 · Shop all →' }}
  </a>
</div>

<header class="arzive-header">
  <div class="arzive-shell arzive-header__grid">
    <nav class="arzive-header__left" aria-label="Primary">
      <a class="arzive-nav-link" href="{{ routes.all_products_collection_url }}">
        <span class="arzive-nav-link__full">Shop all</span>
        <span class="arzive-nav-link__short">Shop</span>
      </a>
      <a class="arzive-nav-link" href="{{ story_url }}">
        <span class="arzive-nav-link__full">Why Arzive</span>
        <span class="arzive-nav-link__short">Story</span>
      </a>
    </nav>

    <a class="arzive-wordmark" href="{{ routes.root_url }}">ARZIVE</a>

    <div class="arzive-header__right">
      <a class="arzive-nav-link" href="{{ study_url }}" rel="noopener">
        <span class="arzive-nav-link__full">Study with Arzive</span>
        <span class="arzive-nav-link__short">Study</span>
      </a>
      <a class="arzive-nav-link" href="{{ account_url }}" rel="noopener">Log in</a>
      <a class="arzive-bag" href="{{ routes.cart_url }}" aria-label="Cart">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M7 8.5h10l-.85 11.2a1 1 0 0 1-1 .9H8.85a1 1 0 0 1-1-.9L7 8.5Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
          <path d="M9.2 8.5V7.4a2.8 2.8 0 0 1 5.6 0v1.1" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
        </svg>
        {% if cart.item_count > 0 %}
          <span class="arzive-bag__count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Free shipping over $75 · Shop all →"
    }
  ]
}
{% endschema %}
