{%- liquid
  assign cornell = section.settings.product_cornell
  if cornell == blank and settings.product_cornell != blank
    assign cornell = settings.product_cornell
  endif
  if cornell == blank
    assign cornell = all_products['arzive-cornell-notebook']
  endif
  if cornell == blank
    assign cornell = all_products['cornell-notebook']
  endif

  assign math = section.settings.product_math
  if math == blank and settings.product_math != blank
    assign math = settings.product_math
  endif
  if math == blank
    assign math = all_products['arzive-math-notebook']
  endif
  if math == blank
    assign math = all_products['math-notebook']
  endif

  assign cornell_handle = 'arzive-cornell-notebook'
  if cornell != blank
    assign cornell_handle = cornell.handle
  endif
  assign math_handle = 'arzive-math-notebook'
  if math != blank
    assign math_handle = math.handle
  endif
-%}

<section class="arzive-products" data-arzive-tabs>
  <div class="arzive-shell">
    <div class="arzive-tabs" role="tablist" aria-label="Notebook models">
      <button
        type="button"
        class="arzive-tab is-active"
        role="tab"
        aria-selected="true"
        data-tab="cornell"
      >
        Cornell
      </button>
      <button
        type="button"
        class="arzive-tab"
        role="tab"
        aria-selected="false"
        data-tab="math"
      >
        Math
      </button>
    </div>

    <div class="arzive-tab-panel is-active" data-panel="cornell" role="tabpanel">
      {% render 'product-showcase',
        product: cornell,
        fallback_handle: cornell_handle,
        color_name: 'Cream',
        cover_asset: 'notebook-cream.jpg',
        fallback_title: 'Cornell Notebook',
        fallback_text: 'Cue, Main Notes, and Summary — the classic Cornell system on recycled cream paper, spiral-bound for lectures and revision.'
      %}
    </div>

    <div class="arzive-tab-panel" data-panel="math" role="tabpanel" hidden>
      {% render 'product-showcase',
        product: math,
        fallback_handle: math_handle,
        color_name: 'Forest green',
        cover_asset: 'notebook-green.jpg',
        fallback_title: 'Math Notebook',
        fallback_text: 'Grid for Example and Practice Questions, with Formulas and Explanations beside — built for problem sets that need room to think.'
      %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product tabs",
  "tag": "section",
  "class": "section-product-tabs",
  "settings": [
    {
      "type": "product",
      "id": "product_cornell",
      "label": "Cornell Notebook product"
    },
    {
      "type": "product",
      "id": "product_math",
      "label": "Math Notebook product"
    }
  ],
  "presets": [
    {
      "name": "ARZIVE product tabs"
    }
  ]
}
{% endschema %}
