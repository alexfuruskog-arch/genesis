<section class="arzive-quote">
  <p class="arzive-quote__mark" aria-hidden="true">A</p>
  <p class="arzive-quote__text">
    {{ section.settings.quote | default: 'The palest ink is better than the strongest memory.' }}
  </p>
  <p class="arzive-quote__attr">
    {{ section.settings.attribution | default: '— Chinese proverb' }}
  </p>
</section>

{% schema %}
{
  "name": "Quote",
  "tag": "section",
  "class": "section-quote",
  "settings": [
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "The palest ink is better than the strongest memory." },
    { "type": "text", "id": "attribution", "label": "Attribution", "default": "— Chinese proverb" }
  ],
  "presets": [{ "name": "ARZIVE quote" }]
}
{% endschema %}
